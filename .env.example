ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./meeting_notes.db
DATABASE_ECHO=false
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=
HIPAA_MASTER_KEY=
ADMIN_API_ENABLED=false
ADMIN_API_TOKEN=
MEETING_RATE_LIMIT_FREE_DAILY=100
MEETING_RATE_LIMIT_PRO_DAILY=10000
MEETING_RATE_LIMIT_ENTERPRISE_UNLIMITED=true
MEETING_RATE_LIMIT_BURST_FACTOR=1.0

# ── Secure file storage (v0.7.0) ───────────────────────────────────────────
# Backend: local (default) | s3 (AWS S3, Cloudflare R2, or MinIO)
STORAGE_BACKEND=local
# Local backend root (default: data/storage)
STORAGE_LOCAL_DIR=data/storage
# S3/R2/MinIO connection (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET=meeting-notes-ai
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# At-rest encryption: none (default) | aes256gcm
STORAGE_ENCRYPTION=none
# Key for at-rest encryption (falls back to HIPAA_MASTER_KEY)
STORAGE_ENCRYPTION_KEY=
# HIPAA retention: 6-year default, sweep cadence in seconds
DEFAULT_RETENTION_DAYS=2190
RETENTION_SWEEP_INTERVAL_SECONDS=86400
